{
  "home": {
    "title": "Scriptorium",
    "quote": "\"Nothing has such power to broaden the mind as the ability to investigate systematically and truly all that comes under thy observation in life.\"",
    "quoteAuthor": "(Marcus Aurelius, Meditations, III, 11)",
    "tools": {
      "image": {
        "label": "Copyist",
        "description": "OCR on images, filters, straightening, drawing and annotation. The starting point for digitizing a text from a paper scan."
      },
      "coder": {
        "label": "Scriptor",
        "description": "XML-TEI editor with poetic autotagging, schema validation, search/replace and advanced encoding tools."
      },
      "viewer": {
        "label": "Librarius",
        "description": "Reads the XML document and turns it into HTML for reading. Supports user notes, text search and navigation."
      },
      "assembler": {
        "label": "Compilator",
        "description": "Imports multiple XML files and allows reordering via drag&drop. The documents can be assembled into a single TEI document, or it can perform a collation of serialized documents."
      },
      "headerbuilder": {
        "label": "Exemplator",
        "description": "Generates the <teiHeader> (titles, authors, lists of people/places) from the terms extracted from the text."
      },
      "vocabulary": {
        "label": "Glossographus",
        "description": "Extracts, edits and exports the vocabulary of words found in the current XML document in the Coder."
      },
      "speculum": {
        "label": "Speculum",
        "description": "Philological statistics and wordcloud on the current XML document in the Coder: tokens, types, TTR, hapax, frequent tags, named entities and distributions."
      },
      "export": {
        "label": "Export",
        "description": "Exports the document to PDF or HTML, ready for publication or sharing."
      }
    },
